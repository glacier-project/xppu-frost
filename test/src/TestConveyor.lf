target Python{
    fast: true,
    timeout: 180 s,
}

import Conveyor from "../../src/conveyor/Conveyor.lf";

preamble{=
import uuid
from material import SteelMaterial, PlasticMaterial

logger = logging.getLogger("test_conveyor")
logger.setLevel(logging.DEBUG)
PYGAME_MANAGER = None
=}

main reactor TestConveyor {

    timer add_wps(0 ms, 100 ms)

    // Each conveyor gets its OWN workpiece instances. The two conveyors mutate
    // each WP's shape every tick, so sharing a single instance across both would
    // let them corrupt each other's positions (nondeterministically, under the
    // multi-threaded runtime).
    state wps_forward = {=
        [
            SteelMaterial(id=str(uuid.uuid4())),
            PlasticMaterial(id=str(uuid.uuid4()))
        ]
    =}
    state wps_reverse = {=
        [
            SteelMaterial(id=str(uuid.uuid4())),
            PlasticMaterial(id=str(uuid.uuid4()))
        ]
    =}
    state wp_index = 0

    state c_wps_received = []
    state c_reverse_wps_received = []

    c = new Conveyor(name="conveyor")
    c_reverse = new Conveyor(name="conveyor_reverse")

    reaction (add_wps) -> c.wp_in_start, c_reverse.wp_in_end {=
        if self.wp_index >= len(self.wps_forward):
            return 0 # No more WPs to add

        fwd_wp = self.wps_forward[self.wp_index]
        rev_wp = self.wps_reverse[self.wp_index]
        self.wp_index += 1
        c.wp_in_start.set(fwd_wp)
        c_reverse.wp_in_end.set(rev_wp)
        logger.debug(f"Added WPs {fwd_wp} (forward) / {rev_wp} (reverse) to conveyors")
    =}

    reaction (c.wp_out_end, c_reverse.wp_out_start) {=
        if c.wp_out_end.is_present:
            logger.debug(f"Received WP {c.wp_out_end.value} from conveyor")
            self.c_wps_received.append(c.wp_out_end.value)
        if c_reverse.wp_out_start.is_present:
            logger.debug(f"Received WP {c_reverse.wp_out_start.value} from reverse conveyor")
            self.c_reverse_wps_received.append(c_reverse.wp_out_start.value)
    =}

    reaction (shutdown) {=
        assert self.c_wps_received == self.wps_forward, f"Expected WPs {self.wps_forward}, but received {self.c_wps_received}"
        assert self.c_reverse_wps_received == self.wps_reverse, f"Expected WPs {self.wps_reverse}, but received {self.c_reverse_wps_received}"
    =}
}
