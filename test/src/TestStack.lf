target Python{
    fast: true,
}

import Stack from "../../src/stack/Stack.lf"

preamble{=
import uuid
from frost import *
from f_compare import *
from monostable_cylinder import MonostableCylinderCmd, MonostableCylinderState
from shape import Shape, CircleShape, RectangularShape, MaterialSquareShape, ComponentShape, ConveyorBeltShape, Point
from shape_utils import set_wp_coordinates_to
from stack import StackCmd
from material import Position, Material, SteelMaterial, PlasticMaterial
from copy import deepcopy

logger = logging.getLogger("test_stack")
logger.setLevel(logging.DEBUG)
stack_wps = [
    SteelMaterial(id=str(uuid.uuid4())),
    PlasticMaterial(id=str(uuid.uuid4())),
    SteelMaterial(id=str(uuid.uuid4()))
]
=}

main reactor {
    state wp_index = 0
    state is_empty = False
    state received_wps = []
    logical action request_wp;

    s = new Stack(name = "stack", buffer = {=deepcopy(stack_wps)=})

    reaction (startup) -> request_wp{=
        request_wp.schedule(0)
    =}

    reaction (request_wp) -> s.provide_wp{=
        logger.debug("Requesting WP from Stack")
        s.provide_wp.set(True)
    =}

    reaction (s.is_empty) {=
        self.is_empty = s.is_empty.value
    =}

    reaction (s.wp_at_pickup) -> request_wp{=
        current_time = lf.time.logical_elapsed()
        wp = s.wp_at_pickup.value

        assert stack_wps[self.wp_index] == wp, f"Expected WP {stack_wps[self.wp_index]}, got {wp}"
        self.wp_index += 1
        assert current_time == 461176 * self.wp_index, f"Expected time {461176 * self.wp_index} ns, got {current_time} ns"
        self.received_wps.append(wp)
        request_wp.schedule(0)
    =}

    reaction (shutdown){=
        assert self.is_empty, "Expected stack to be empty"
        assert self.received_wps == stack_wps, f"Expected received WPs {stack_wps}, got {self.received_wps}"

    =}
}
