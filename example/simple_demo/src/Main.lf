stack_buffer = [
    SteelMaterial(id=str(uuid.uuid4())),
    PlasticMaterial(id=str(uuid.uuid4())),
    SteelMaterial(id=str(uuid.uuid4()))
]
=}

reactor KafkaProducer extends FrostReactor {
    preamble{=
        def run_asyncio_loop(
            self,
            shutdown_evt: asyncio.Event
            ):

            async def wait_for_event():
                '''Wait for the shutdown event to be set.
                '''
                self.loop = asyncio.get_running_loop()
                await asyncio.wait_for(shutdown_evt.wait(), None)
            asyncio.run(wait_for_event())

        async def start_kafka_producer(
            self,
            kafka_bootstrap_servers: str,
        ):
            '''Start the Kafka producer.
            Args:
                kafka_bootstrap_servers (str): The Kafka bootstrap servers.
            '''
            self.kafka_producer = AIOKafkaProducer(
                bootstrap_servers=kafka_bootstrap_servers
            )
            await self.kafka_producer.start()
            self.logger.debug(f"Kafka producer started with bootstrap servers: {kafka_bootstrap_servers}")
            return True

        async def stop_kafka_producer(self):
            '''Stop the Kafka producer.
            Args:
                ice_proxy (ReactorBase): The ICEProxy reactor instance.
            '''
            if self.kafka_producer is not None:
                await self.kafka_producer.stop()
                self.kafka_producer = None
                self.logger.debug("Kafka producer stopped")

        async def send_message_to_kafka(
            self,
            topic: str,
            message: str
        ):
            '''Send a message to the specified Kafka topic.
            Args:
                topic (str): The Kafka topic to send the message to.
                message (str): The message to send.
            '''
            result = await self.kafka_producer.send_and_wait(topic, message.encode("utf-8"))
            return result
    =}

    state kafka_topic = "xppu_data"

    // @label setup_kafka_producer
    reaction (startup) {=
        # Use port 9093 for host connections, 9092 for container-to-container
        kafka_bootstrap_servers = os.getenv("KAFKA_BOOTSTRAP_SERVERS", "localhost:9093")

        self.shutdown_evt = asyncio.Event()
        self.thread = threading.Thread(
            target=self.run_asyncio_loop,
            daemon=True,
            kwargs={
                "shutdown_evt": self.shutdown_evt,
            }
        )
        self.thread.start()

        time.sleep(0.1)  # Give some time for the thread to start

        asyncio.run_coroutine_threadsafe(
            self.start_kafka_producer(
                kafka_bootstrap_servers
            ),
            self.loop
        ).result()  # Wait for the producer to start
        self.logger.info("KafkaProducer reactor initialized")
    =}

    // @label subscribe_to_xppu_vars
    reaction(connected_to_bus) -> channel_out {=
        msgs = [
            self.message_builder.build_subscribe_variable_message(
                target="xppu",
                node=xppu_var
            )
            for xppu_var in XPPU_DATA_MODEL_NODES
        ]

        self._set_channel_out_port(msgs, channel_out)
    =}

    // @label handle_xppu_var_updates
    reaction(response_messages) {=
        for bank_index, message in response_messages.value:

            if message.header.msg_name != VariableMsgName.UPDATE:
                continue

            self.logger.debug(f"KafkaProducer: Received variable update message: {message}")
            result = asyncio.run_coroutine_threadsafe(
                self.send_message_to_kafka(
                    self.kafka_topic,
                    # Serialize the dataclass to JSON
                    json.dumps(asdict(message), default=str)
                ),
                self.loop
            ).result()  # Wait for the message to be sent
            if not result:
                self.logger.error(f"KafkaProducer: Failed to send message to Kafka topic {topic}: {metric}")
    =}

    // @label _tear_down_kafka_producer
    reaction(shutdown){=
        '''Tear down the KafkaProducer reactor and close the Kafka producer.'''
        self.logger.info("Shutting down KafkaProducer reactor")

        # Close the Kafka producer first (while loop is still running)
        asyncio.run_coroutine_threadsafe(self.stop_kafka_producer(), self.loop).result()

        # Signal the asyncio loop thread to stop
        self.shutdown_evt.set()

        if self.thread is not None:
            self.logger.info("Waiting for the asyncio loop thread to finish")
            self.thread.join(timeout=2.0)
            if self.thread.is_alive():
                self.logger.warning("Asyncio loop thread did not finish in time")
            else:
                self.logger.info("Asyncio loop thread finished")
    =}
}

reactor XPPUScheduler(_scheduling_instance="undefined", _scheduling_interval=1) extends FrostMachine{
    input is_stack_empty
    input stack_wp_at_pickup

    state scheduling_instance = _scheduling_instance
    state scheduling_interval = _scheduling_interval # in s
    state recipe_template = "undefined"
    state _executor
    state _active_tasks = {={}=}
    state request_wp = True
    logical action task_completed
    logical action start_tasks
    logical action update_schedule

    reaction(startup) {=
        self.scheduling_instance = load_instance_from_json(self.scheduling_instance)
        self._executor = DynamicExecutor(DummySolver(instance=self.scheduling_instance))

        with open(self.recipe_template, "r") as f:
            self.recipe_template = Job.model_validate_json(f.read())
        self.logger.info(f"Loaded recipe template job: {self.recipe_template}")
    =}

    method create_method_request(t, method_path, args, kwargs){=
        return self.message_builder.build_invoke_method_message(
            target=t,
            node=method_path,
            args=args,
            kwargs=kwargs
        )
    =}

    method send_stack_wp_request(channel_out){=
        msg = self.message_builder.build_invoke_method_message(target="xppu", node="/xPPU/Stack/Methods/RequestWp")
        self._set_channel_out_port(msg, channel_out)
    =}

    // @label connected_to_bus
    reaction(connected_to_bus) -> update_schedule, channel_out{=
        self.logger.info("Connected to bus. Starting scheduling...")
        update_schedule.schedule(0)

        self.send_stack_wp_request(channel_out)
    =}

    reaction(is_stack_empty, stack_wp_at_pickup) {=
        if is_stack_empty.is_present:
            self.logger.info("XPPU stack is empty. Stopping requesting workpieces.")
            self.request_wp = False

        if stack_wp_at_pickup.is_present:
            # Add a new Job to the scheduler for processing the workpiece
            recipe = self.recipe_template.model_copy(deep=True)
            current_instance = self._executor.solver.instance
            self._executor.solver = DummySolver(instance= SchedulingInstance(
                jobs=current_instance.jobs + [recipe],
                machines=current_instance.machines,
                travel_times=current_instance.travel_times,
            ))
    =}

    // @label update_schedule
    reaction(update_schedule) -> update_schedule, start_tasks{=
        executor = self._executor
        logical_time = self._get_current_logical_time_sec()
        self.logger.debug(f"Scheduling at logical time {logical_time} sec")
        executor.update_task_status()
        # TODO: Frost planner should support starting from logical time different than 0
        schedule = executor.update_schedule(start_time=0)

        # get the tasks that can be started now
        next_tasks = executor.next_ready_tasks()
        if next_tasks:
            start_tasks.schedule(0, next_tasks)

        scheduling_interval = SECS(self.scheduling_interval)
        self.logger.debug(f"Scheduling next task in {scheduling_interval} s...")
        update_schedule.schedule(scheduling_interval)
    =}

    // @label run_tasks
    reaction(start_tasks) {=
        self.logger.info(f"Starting tasks: {start_tasks.value}")

        # Add here the request of the new workpiece if needed

        for task, machine in start_tasks.value:
            machine = machine.name
            task_name = task.task.name
            self.logger.info(f"Starting task {task_name} on machine {machine}")
            task.start_time = self._get_current_logical_time_sec()
            self._executor.task_started(task)

            msg = self.create_method_request(self.data_model.name, f"/XPPUScheduler/Methods/{task_name}", args=[machine, f"/Machine/{task_name}"], kwargs={})
            self._active_tasks[msg.correlation_id] = task
            self.protocol_mng.handle_request(msg)

    =}

    reaction(response_messages) -> channel_out{=
        for bank_index, message in response_messages.value:

            if message.correlation_id not in self._active_tasks:
                continue

            if message.header.msg_name != MethodMsgName.COMPLETED:
                continue

            task = self._active_tasks.pop(message.correlation_id)
            task.end_time = self._get_current_logical_time_sec()
            self._executor.task_completed(task)
            self.logger.info(f"Task {task.task.name} completed on machine {task.machine.name}")

            if task.task.name == "PickStackStampToLSC" and self.request_wp:
                self.send_stack_wp_request(channel_out)
    =}

}
main reactor {
    xppu = new XPPU(name="xppu", stack_buffer={= deepcopy(stack_buffer)=})
    bus = new FrostBus(name="frost_bus", width=3)
    xppu_scheduler = new XPPUScheduler(name="xppu_scheduler", update_interval=100 ms)
    kafka_producer = new KafkaProducer(name="kafka_producer")

    xppu.channel_out, xppu_scheduler.channel_out, kafka_producer.channel_out -> bus.channel_in
    bus.channel_out -> xppu.channel_in, xppu_scheduler.channel_in, kafka_producer.channel_in after 0
    xppu.is_stack_empty -> xppu_scheduler.is_stack_empty;
    xppu.stack_wp_at_pickup -> xppu_scheduler.stack_wp_at_pickup;
}
