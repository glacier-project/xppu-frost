# Kafka
import json
import time
import threading
import asyncio
from dataclasses import asdict
from aiokafka import AIOKafkaProducer

logger = logging.getLogger("sc14")
logger.setLevel(logging.INFO)
crane_dpos={
    CranePos.POS_S:np.pi,
    CranePos.POS_LSC:(3/2)*np.pi,
