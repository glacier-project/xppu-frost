reactor KafkaProducer extends FrostReactor {

    reaction(connected_to_bus) -> channel_out {=
        msgs = [
            self.message_builder.build_subscribe_variable_message(
                target="xppu",
                node=xppu_var
            )
            for xppu_var in XPPU_DATA_MODEL_NODES
        ]

        self._set_channel_out_port(msgs, channel_out)
    =}

    reaction(response_messages) {=
        for bank_index, message in response_messages.value:

            if message.header.msg_name != VariableMsgName.UPDATE:
                continue

            self.logger.info(f"KafkaProducer: Received variable update message: {message}")
    =}


}

reactor XPPUScheduler(_scheduling_instance="undefined", _scheduling_interval=1) extends FrostMachine{
    input is_stack_empty
    input stack_wp_at_pickup

    state scheduling_instance = _scheduling_instance
    state scheduling_interval = _scheduling_interval # in seconds
    state recipe_template = "undefined"
    state _executor
    state _active_tasks = {={}=}
    state request_wp = True
    logical action task_completed
    logical action start_tasks
    logical action update_schedule

    reaction(startup) {=
        self.scheduling_instance = load_instance_from_json(self.scheduling_instance)
        self._executor = DynamicExecutor(GeneticAlgorithmSolver(instance=self.scheduling_instance))


    =}

    method create_method_request(t, method_path, args, kwargs){=
        return self.message_builder.build_invoke_method_message(
            target=t,
            node=method_path,
            args=args,
            kwargs=kwargs
        )
    =}

    method send_stack_wp_request(channel_out){=
        msg = self.message_builder.build_invoke_method_message(target="xppu", node="/xPPU/Stack/Methods/RequestWp")
        self._set_channel_out_port(msg, channel_out)
    =}

    // @label connected_to_bus
    reaction(connected_to_bus) -> update_schedule, channel_out{=
        self.logger.info("Connected to bus. Starting scheduling...")
        update_schedule.schedule(0)

        self.send_stack_wp_request(channel_out)
    =}

    # TODO: revise
    reaction(is_stack_empty, stack_wp_at_pickup) {=
        if is_stack_empty.is_present:
            self.logger.info("XPPU stack is empty. Stopping requesting workpieces.")
            self.request_wp = False

        if stack_wp_at_pickup.is_present and self.request_wp:
            # TODO: Add a new Job/Task to the scheduling instance for the received workpiece
            pass

        # TODO: think about when to request the next workpiece. Index based? Only after the previous task is completed?
        # self.send_stack_wp_request(channel_out)

    =}

    // // @label update_schedule
    // reaction(update_schedule) -> update_schedule, start_tasks{=
    //     executor = self._executor
