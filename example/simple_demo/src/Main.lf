main reactor {
    state received_wp = []

    xppu = new XPPU(name="xppu")
    bus = new FrostBus(name="frost_bus", width=3)
    xppu_scheduler = new XPPUScheduler(name="xppu_scheduler", update_interval=100 ms)
    kafka_producer = new KafkaProducer(name="kafka_producer")

    xppu.channel_out, xppu_scheduler.channel_out, kafka_producer.channel_out -> bus.channel_in
    bus.channel_out -> xppu.channel_in, xppu_scheduler.channel_in, kafka_producer.channel_in after 0
    xppu.is_stack_empty -> xppu_scheduler.is_stack_empty;
    xppu.stack_wp_at_pickup -> xppu_scheduler.stack_wp_at_pickup;
}
